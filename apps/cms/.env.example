# Base URL of the While Building API (the separate `while-building-api` repository).
# The CMS sends cookies to this origin (httpOnly refresh cookie), so the API must allow this
# app's origin in CORS_ORIGIN and respond with Access-Control-Allow-Credentials: true.
# Vite embeds VITE_* variables into the bundle at build time — never put secrets here.
VITE_API_URL=http://localhost:3000

# Base URL of the While Building assistant (`apps/ai` in while-building-api). It receives the same
# in-memory access token as a bearer header (no cookies); its CORS_ORIGIN must list this app's origin.
# The LLM key stays on that server — never put secrets here.
VITE_AI_URL=http://localhost:3004
