# Base URL of the While Building API (the separate `while-building-api` repository).
# Vite embeds VITE_* variables into the client bundle at build time — never put secrets here.
VITE_API_URL=http://localhost:3000

# Public origin of this site, e.g. https://whilebuilding.dev — used for canonical URLs and og:url.
# Optional; leave unset in development.
# VITE_SITE_URL=
